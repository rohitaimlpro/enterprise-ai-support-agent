# Copy this file to .env and fill in real values before running docker compose.

# --- LLM (Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# Chat model. gemini-2.5-flash-lite is cheaper but was measured unreliable at calling
# tools when replying in Hinglish -- see backend/app/agent/llm.py before switching.
LLM_MODEL=gemini-2.5-flash

# --- Voice (optional: text chat works without these) ---
# Speech-to-text: Groq Whisper. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Text-to-speech: Azure Neural voices. Create a "Speech" resource in the Azure
# portal; use its key and region (e.g. eastus). Without these, voice replies
# fall back to on-screen captions.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=hi-IN-SwaraNeural
# Azure *Custom* Neural Voice (optional). Needs a custom voice you have trained
# and deployed in your Speech resource (Speech Studio -> Custom Voice ->
# Deploy model). Put the deployment's endpoint id here and the custom voice's
# name in AZURE_TTS_VOICE. If the custom endpoint ever fails, speech falls back
# to AZURE_TTS_FALLBACK_VOICE instead of going silent.
AZURE_TTS_ENDPOINT_ID=
AZURE_TTS_FALLBACK_VOICE=hi-IN-SwaraNeural
# Voices offered in the UI's voice picker (comma-separated). Only these, plus AZURE_TTS_VOICE, are accepted.
# AZURE_TTS_VOICES=hi-IN-SwaraNeural,hi-IN-KavyaNeural,en-IN-NeerjaIndicNeural
# SSML language tag; only needed for a custom voice (its name has no locale). Default hi-IN.
AZURE_TTS_LOCALE=
# "hinglish" (Hindi-English mix in Roman script) or "english". Affects replies,
# the "checking..." lines and the speech-recognition hint.
ASSISTANT_LANGUAGE=hinglish
# Force Whisper's language ("hi", "en"); leave empty to auto-detect.
GROQ_STT_LANGUAGE=
# Limits (cost/abuse protection)
VOICE_MAX_CONCURRENT_SESSIONS=20
VOICE_MAX_SESSION_SECONDS=1800
VOICE_IDLE_SECONDS=300
# Longest answer read aloud, in characters (~450 = 30 s of speech); the rest stays on screen. 0 = no limit.
VOICE_MAX_SPOKEN_CHARS=450

# --- Postgres ---
POSTGRES_USER=support_app
POSTGRES_PASSWORD=support_app_password
POSTGRES_DB=support_agent
# Host used by the backend container. When running the backend outside
# Docker (e.g. `uvicorn` on your laptop), change this to "localhost" and
# POSTGRES_PORT to 5433 (docker-compose publishes Postgres on 5433 on the
# host to avoid clashing with a Postgres you might already have running).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://support_app:support_app_password@postgres:5432/support_agent

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Chroma (embedded, persisted to disk) ---
CHROMA_PERSIST_DIR=/app/chroma_data

# --- Observability (all optional) ---
# Set these two to enable automatic LangSmith tracing of every agent run.
# LangChain picks them up itself -- no extra code needed.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-support-agent

LOG_LEVEL=INFO
