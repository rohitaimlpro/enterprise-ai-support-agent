# Copy this file to .env and fill in real values before running docker compose.

# --- LLM (Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Postgres ---
POSTGRES_USER=support_app
POSTGRES_PASSWORD=support_app_password
POSTGRES_DB=support_agent
# Host used by the backend container. When running the backend outside
# Docker (e.g. `uvicorn` on your laptop), change this to "localhost" and
# POSTGRES_PORT to 5433 (docker-compose publishes Postgres on 5433 on the
# host to avoid clashing with a Postgres you might already have running).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://support_app:support_app_password@postgres:5432/support_agent

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Chroma (embedded, persisted to disk) ---
CHROMA_PERSIST_DIR=/app/chroma_data

# --- Observability (all optional) ---
# Set these two to enable automatic LangSmith tracing of every agent run.
# LangChain picks them up itself -- no extra code needed.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-support-agent

LOG_LEVEL=INFO
